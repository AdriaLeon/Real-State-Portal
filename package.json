{
  "name": "real-state-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "crawl": "tsx scripts/crawl.ts",
    "normalize": "tsx scripts/normalize.ts",
    "enrich": "tsx --env-file=.env scripts/enrich.ts",
    "db:generate": "node --env-file=.env node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate dev",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:studio": "node --env-file=.env node_modules/prisma/build/index.js studio",
    "dev:api": "tsx --env-file=.env app/api/index.ts",
    "dev:docker": "docker compose up -d",
    "dev:front": "vite --config app/front-end/vite.config.ts",
    "dev": "npm run dev:docker && concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:front\"",
    "build": "tsc --noEmit && vite build --config app/front-end/vite.config.ts",
    "preview": "vite preview --config app/front-end/vite.config.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.17.0",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cheerio": "^1.0.0",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "prisma": "^7.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.0"
  }
}
