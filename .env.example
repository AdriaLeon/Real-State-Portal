# MySQL Docker credentials
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_DATABASE=real_state_portal

# MySQL connection string used by Prisma (must match MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE)
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@localhost:3306/${MYSQL_DATABASE}"

# Gemini API key for AI enrichment / query parsing (scripts/enrich.ts, lib/ai)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
