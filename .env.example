# MySQL Docker credentials
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_DATABASE=real_state_portal

# MySQL connection string used by Prisma (must match MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE below —
# written out literally, not with ${VAR} refs, since Node's --env-file loader doesn't expand those).
# allowPublicKeyRetrieval=true is required against the mysql:8 image: it defaults to the
# caching_sha2_password auth plugin, which the mariadb driver can't complete without it —
# without this param every connection silently fails auth and the pool just times out.
DATABASE_URL="mysql://app_user:app_password@localhost:3306/real_state_portal?allowPublicKeyRetrieval=true"

# `prisma migrate dev` needs a scratch "shadow" database to compute schema diffs.
SHADOW_DATABASE_URL="mysql://root:root_password@localhost:3306/real_state_portal_shadow?allowPublicKeyRetrieval=true"

# Gemini API key for AI enrichment / query parsing (scripts/enrich.ts, lib/ai)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Port the Express API listens on (optional — defaults to 3000).
PORT=3000
